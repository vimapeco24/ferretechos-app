# Supabase Configuration
# Copia este archivo como .env y llena con tus credenciales de Supabase
# Settings > API en tu proyecto de Supabase

# URL del proyecto (Settings → API → Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
REACT_APP_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anon/public (Settings → API → anon public)
SUPABASE_ANON_KEY=eyJ...tu-anon-key-aqui...
REACT_APP_SUPABASE_ANON_KEY=eyJ...tu-anon-key-aqui...

# (Opcional) Service role key para operaciones del servidor
# Solo necesaria si desactivas las políticas RLS permisivas
# SUPABASE_SERVICE_KEY=eyJ...tu-service-key...
